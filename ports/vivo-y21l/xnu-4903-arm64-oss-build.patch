diff --git a/makedefs/genassym_extract.py b/makedefs/genassym_extract.py
new file mode 100644
index 0000000..e9ba582
--- /dev/null
+++ b/makedefs/genassym_extract.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Extract DECLARE() values from clang -S output of genassym.c.
+
+Replaces the historical sed pipeline, which only understands .ascii "N".
+Modern clang folds a single-character .ascii into .byte <ascii code>.
+"""
+import re
+import sys
+
+LABEL = re.compile(r'^\s*DEFINITION__define__([A-Za-z0-9_]+):\s*(.*)$')
+ASCII = re.compile(r'\.ascii\s+"([^"]*)"')
+BYTE = re.compile(r'\.byte\s+(\d+)\s*$')
+
+
+def main():
+    lines = open(sys.argv[1], 'r', errors='replace').read().splitlines()
+    out = []
+    i = 0
+    while i < len(lines):
+        m = LABEL.match(lines[i])
+        if not m:
+            i += 1
+            continue
+        name, rest = m.group(1), m.group(2)
+        if not rest.strip() and i + 1 < len(lines):
+            rest = lines[i + 1]
+            i += 1
+        i += 1
+        value = None
+        a = ASCII.search(rest)
+        if a:
+            s = a.group(1).strip().lstrip('$#')
+            if s:
+                value = int(s)
+        else:
+            b = BYTE.search(rest)
+            if b and 48 <= int(b.group(1)) <= 57:
+                value = int(b.group(1)) - 48
+        if value is None:
+            sys.stderr.write('genassym: cannot parse %s: %r\n' % (name, rest))
+            continue
+        out.append('#define %s %d' % (name, value))
+        out.append('#define %s_NUM %d' % (name, value))
+    sys.stdout.write('\n'.join(out) + '\n')
+
+
+if __name__ == '__main__':
+    main()
