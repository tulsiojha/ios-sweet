+	usbcon_shm_puts("usb: run\r\n");
+#endif
+}
+
+static void
+usbcon_init(void)
+{
+	usbcon_base = ml_io_map(USBCON_USB_PA, USBCON_MAP_SIZE);
+	usbcon_gcc = ml_io_map(USBCON_GCC_PA, USBCON_MAP_SIZE);
+	usbcon_dma_pa = ml_vtophys((vm_offset_t)&usbcon_dma);
+
+	usbcon_hw_init();
+}
+
+#if defined(MSM8916_PORT)
+/*
+ * Persistent early log for stage0.
+ *
+ * Nothing guarantees that the USB console can be adopted from stage0, and
+ * this kernel currently resets a few seconds into arm_init, so the probes
+ * also go to a SHMCON v2 ring at the ADT "pram" node (physBase + memSize,
+ * top of DRAM). start.s maps that 2 MB block into the V=P window as
+ * Device memory, so a store reaches DRAM immediately and needs no cache
+ * maintenance. The stage0 loader's dump_prev_shmcon() prints the ring on
+ * the next boot, which makes the log survive whatever kills the SoC.
+ * Layout is struct shmcon_header from the SHMCON backend below.
