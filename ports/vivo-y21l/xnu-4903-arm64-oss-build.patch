+static volatile uint8_t *usbcon_shm_out;
+static volatile uint32_t *usbcon_shm_head;
+static vm_offset_t usbcon_shm_pa;
+static uint32_t usbcon_shm_len;
+static uint32_t usbcon_shm_head_val;
+
+static void
+usbcon_shm_init(vm_offset_t pram_pa)
+{
+	volatile uint32_t *h = (volatile uint32_t *)pram_pa;
+	uint32_t out_pa = (uint32_t)(pram_pa + USBCON_SHM_OUT_OFF);
+	uint32_t out_len = USBCON_SHM_SIZE - USBCON_SHM_OUT_OFF;
