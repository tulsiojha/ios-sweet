+	h[1] = (uint32_t)USBCON_SHM_VERSION |
+	    ((uint32_t)USBCON_SHM_CHILDREN << 8);
+	h[2] = 0;                       /* buf_paddr[CBUF_IN] (unused) */
+	h[3] = 0;
+	h[4] = out_pa;                  /* buf_paddr[CBUF_OUT] */
+	h[5] = 0;
+	h[6] = 0x1000;                  /* buf_len[CBUF_IN] */
+	h[7] = out_len;                 /* buf_len[CBUF_OUT] */
