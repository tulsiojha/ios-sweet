+		*(volatile uint8_t *)(pram_pa + 32 + i) =
+		    (uint8_t)"AP-xnu  "[i];
+	}
+	*(volatile uint32_t *)(pram_pa + 64) = 0;       /* sidx[CBUF_IN] */
+	*(volatile uint32_t *)(pram_pa + 68) = 0;       /* sidx[CBUF_OUT] */
+	*(volatile uint32_t *)(pram_pa + 128) = 0;      /* midx[CBUF_IN] */
+	*(volatile uint32_t *)(pram_pa + 132) = 0;      /* midx[CBUF_OUT] */
+	for (i = 0; i < USBCON_SHM_CHILDREN; i++) {
+		*(volatile uint64_t *)(pram_pa + 136 + 8 * i) = 0;
+	}
+
+	usbcon_shm_pa = pram_pa;
+	usbcon_shm_out = (volatile uint8_t *)(pram_pa + USBCON_SHM_OUT_OFF);
+	usbcon_shm_head = (volatile uint32_t *)(pram_pa + USBCON_SHM_HEAD_OFF);
+	usbcon_shm_len = out_len;
+	usbcon_shm_head_val = 0;
+
+	__asm__ volatile ("dmb sy" ::: "memory");
+	h[0] = USBCON_SHM_MAGIC;
+	__asm__ volatile ("dmb sy" ::: "memory");
+}
+
+static void
+usbcon_shm_putc(uint8_t c)
+{
+	if (!usbcon_shm_out) {
+		return;
+	}
+	usbcon_shm_out[usbcon_shm_head_val] = c;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	if (++usbcon_shm_head_val >= usbcon_shm_len) {
+		usbcon_shm_head_val = 0;
+	}
+	*usbcon_shm_head = usbcon_shm_head_val;
+}
+
+static void
+usbcon_shm_puts(const char *s)
+{
+	while (*s) {
+		usbcon_shm_putc((uint8_t)*s++);
+	}
+}
+#endif /* MSM8916_PORT */
+
+/*
+ * Early bring-up from arm_init before arm_vm_init (MSM8916_PORT): start.s
+ * maps the USB, GCC and pram blocks into the V=P window, so the controller
+ * is reachable at its physical address here. The DMA block's physical
+ * address follows the loader's rule pa = va - virtBase + physBase (the
+ * kernel image is physically contiguous in the payload).
+ */
+void
+usbcon_early_start(uint64_t phys_base, uint64_t virt_base, uint64_t mem_size)
+{
+	usbcon_base = USBCON_USB_PA;
+	usbcon_gcc = USBCON_GCC_PA;
+	usbcon_dma_pa = (vm_offset_t)&usbcon_dma - virt_base + phys_base;
+
+#if defined(MSM8916_PORT)
+	usbcon_shm_init((vm_offset_t)(phys_base + mem_size));
+	usbcon_shm_puts("xnu> early start\r\n");
+#endif
+
+	usbcon_hw_init();
+}
+
+void
+usbcon_early_puts(const char *s)
+{
+	uint64_t deadline = usbcon_now_ms() + 500;
+
+#if defined(MSM8916_PORT)
+	usbcon_shm_puts(s);
+#endif
+	while (*s) {
+		usbcon_ring_putc((uint8_t)*s++);
+	}
+	/* Keep polling until the host drains the ring (or 500 ms) so early
+	 * messages are not stranded when execution stops soon after. */
+	while (usbcon_now_ms() < deadline) {
+		usbcon_pump();
+		if (usbcon_configured && usbcon_ring_r == usbcon_ring_w &&
+		    !usbcon_tx_busy) {
+			break;
+		}
+	}
+}
+
+/*
+ * Called from arm_vm_init right after pmap_bootstrap, when the V=P window
+ * has been replaced: move the registers to real KVA mappings. The DMA
+ * block and the controller state carry over; no reset, no re-enumeration.
+ */
+void
+usbcon_rebind(void)
+{
+	usbcon_base = ml_io_map(USBCON_USB_PA, USBCON_MAP_SIZE);
+	usbcon_gcc = ml_io_map(USBCON_GCC_PA, USBCON_MAP_SIZE);
+#if defined(MSM8916_PORT)
+	if (usbcon_shm_pa) {
+		vm_offset_t va = ml_io_map(usbcon_shm_pa, USBCON_SHM_SIZE);
+
+		usbcon_shm_out = (volatile uint8_t *)(va + USBCON_SHM_OUT_OFF);
+		usbcon_shm_head = (volatile uint32_t *)(va + USBCON_SHM_HEAD_OFF);
+	}
+#endif
+}
+
+static int
+usbcon_tr0(void)
+{
+	return 1;
+}
+
+static void
+usbcon_td0(int c)
+{
+#if defined(MSM8916_PORT)
+	usbcon_shm_putc((uint8_t)c);
+#endif
+	usbcon_ring_putc((uint8_t)c);
+	usbcon_pump();
+}
+
+static int
+usbcon_rr0(void)
+{
+	return 0;
+}
+
+static int
+usbcon_rd0(void)
+{
+	return -1;
+}
+
+static struct pe_serial_functions usbcon_serial_functions = {
+	.uart_init = usbcon_init,
+	.uart_set_baud_rate = NULL,
+	.tr0 = usbcon_tr0,
+	.td0 = usbcon_td0,
+	.rr0 = usbcon_rr0,
+	.rd0 = usbcon_rd0
+};
