diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index f709217..43f3c9c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -33,6 +33,34 @@
 #include <machine/asm.h>
 #include "assym.s"
 
+#if defined(MSM8916_PORT)
+/*
+ * Device-nGnRnE block entry: the early usbcon console maps msm8916's
+ * GCC/USB/QGIC register blocks into the V=P window with this, so it can
+ * run before pmap_bootstrap exists.
+ */
+#define ARM_TTE_BOOT_DEVICE_BLOCK (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_NONE) \
+	                                | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF)
+
+/*
+ * DRAM milestone for the next stage0 boot: the loader prints this word
+ * before it reloads the payload, so after a silent reset it shows how far
+ * start.s got. 0xBFEF0010 is inside the top DRAM 2 MB block that the
+ * mapping code below turns into Device memory; before that the MMU is off
+ * and the store goes straight to DRAM. Clobbers x9 and x10.
+ */
+.macro msm8916_milestone val
+	movz	x9, #0x0010
+	movk	x9, #0xBFEF, lsl #16
+	movz	x10, #\val
+	str	x10, [x9]
+	dsb	sy
+.endm
+#else
+.macro msm8916_milestone val
+.endm
+#endif
+
 #if __ARM_KERNEL_PROTECT__
 #include <arm/pmap.h>
 #endif /* __ARM_KERNEL_PROTECT__ */
@@ -101,7 +129,10 @@ LEXT(LowResetVectorBase)
