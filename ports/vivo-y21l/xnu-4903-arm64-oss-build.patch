+#define USBCON_SHM_MAGIC        0x53484d43u     /* 'SHMC' */
+#define USBCON_SHM_VERSION      2
+#define USBCON_SHM_CHILDREN     5
+#define USBCON_SHM_OUT_OFF      0x1000
+#define USBCON_SHM_HEAD_OFF     132             /* midx[CBUF_OUT] */
+#define USBCON_SHM_SIZE         0x100000        /* pram node reg size */
